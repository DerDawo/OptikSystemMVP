# Supabase-Zugangsdaten fuer my-admin.
#
# Fuer lokale Entwicklung bitte die Werte des Supabase Dev-Branches
# eintragen (nicht Production). Siehe ../supabase/README.md
# ("Dev-Branch (Supabase Branching)") fuer Details zum Einrichten,
# Zuruecksetzen und Ermitteln dieser Werte.

# Supabase-Projekt-/Branch-URL, z. B. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase Publishable/Anon Key des Projekts bzw. Branches
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
